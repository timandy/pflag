# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

#
# The above will handle all files NOT found below
# These files are text and should be normalized (Convert crlf => lf)
#
# Source code
*.c             text
*.cpp           text
*.go            text
*.h             text
*.s             text

# Go modules
go.mod          text
go.sum          text

# Documentation
*.md            text
*.txt           text

# Configuration
*.yaml          text
*.yml           text

# Scripts - always LF regardless of OS
*.sh            text eol=lf
*.bash          text eol=lf

# Batch files - always CRLF regardless of OS
*.bat           text eol=crlf
*.cmd           text eol=crlf

# These files are binary and should be left untouched
# (binary is a macro for -text -diff)
*.dll           binary
*.exe           binary
*.so            binary
